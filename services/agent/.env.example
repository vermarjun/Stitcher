# ─────────────────────────────────────────────
#  Manim Agent Service — environment variables
# ─────────────────────────────────────────────

# Auth (required)
AGENT_API_KEY=your-secret-key-here

# Server
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# Redis — used for job checkpointing and SSE event replay
CHECKPOINT_REDIS_URL=redis://localhost:6379

# ── LLM Provider defaults ──────────────────────
# These are used for /capabilities self-test and internal fallbacks.
# Per-request modelConfig in the request body always overrides these.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL_PLANNER=gpt-4o
DEFAULT_MODEL_CODER=gpt-4o
DEFAULT_MODEL_DEBUGGER=gpt-4o

# ── Provider API keys ──────────────────────────
# Supply the key(s) for whichever provider(s) you use.
# Callers can also pass apiKey inline in modelConfig per-request.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENCODE_GO_API_KEY=        # https://opencode.ai — supports kimi-k2.5, minimax-m2.5, glm-5, mimo-v2-pro
# For Ollama: no key needed, just set baseURL in modelConfig: { provider: "ollama", baseURL: "http://localhost:11434/v1" }

# ── Tools ──────────────────────────────────────
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily          # tavily | serper | brave
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_CALLS_PER_JOB=3

# ── Graph limits ───────────────────────────────
MAX_PARALLEL_SCENES=6
DEFAULT_MAX_VALIDATION_RETRIES=3
DEFAULT_TIMEOUT_SEC=120
MAX_CODE_SIZE_BYTES=524288

# ── Prompts ────────────────────────────────────
PROMPT_VERSION_PLANNER=active
PROMPT_VERSION_CODER=active
PROMPT_VERSION_DEBUGGER=active
PROMPT_VERSION_REFINER=active

# ── Observability ──────────────────────────────
LOG_LEVEL=info                     # trace | debug | info | warn | error
CAPTURE_LLM_IO=false               # write full LLM prompts/responses to sink
LLM_IO_SINK=local                  # local | s3
LLM_IO_LOCAL_PATH=./llm_captures

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Validation ─────────────────────────────────
MANIM_API_INDEX_PATH=./src/assets/manim_api_index.json
RUFF_CONFIG_PATH=./src/assets/ruff_manim.toml
PYTHON_PATH=python3                # path to python with manim/pyflakes/ruff installed
