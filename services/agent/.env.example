# Required: AGENT_API_KEY. Provider keys are required when that provider is used.
# All other entries are optional. Blank values use code defaults.
# DEFAULT_MODEL_* defaults follow DEFAULT_PROVIDER; see src/config.ts.
# Paths default beside the running source or compiled module.
# MANIM_PLUGINS_DIR is only used by scripts/build_cheatsheet.py.
DEFAULT_PROVIDER=openai
AGENT_API_KEY=replace-with-a-service-secret
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
CHECKPOINT_REDIS_URL=redis://localhost:6379
DEFAULT_MODEL_PLANNER=
DEFAULT_MODEL_CODER=
DEFAULT_MODEL_DEBUGGER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENCODE_GO_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_CALLS_PER_JOB=3
MAX_PARALLEL_SCENES=6
DEFAULT_MAX_VALIDATION_RETRIES=3
DEFAULT_TIMEOUT_SEC=300
MAX_CODE_SIZE_BYTES=524288
PROMPT_VERSION_PLANNER=active
PROMPT_VERSION_CODER=active
PROMPT_VERSION_DEBUGGER=active
PROMPT_VERSION_REFINER=active
LOG_LEVEL=info
CAPTURE_LLM_IO=false
LLM_IO_SINK=local
LLM_IO_LOCAL_PATH=./llm_captures
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASEURL=
OTEL_SERVICE_NAME=stitcher-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MANIM_API_INDEX_PATH=
MANIM_CHEATSHEET_PATH=
RUFF_CONFIG_PATH=
SKILLS_DIR=
PYTHON_PATH=python3
AWS_REGION=us-east-1
OTEL_DIAG_DEBUG=false
MANIM_PLUGINS_DIR=
