{
  "name": "manim-agent-service",
  "version": "0.1.0",
  "description": "Agentic Manim code-generation service: prompt → validated Manim Python scenes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "node --max-old-space-size=4096 node_modules/.bin/tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:contract": "jest --testPathPattern=tests/contract",
    "test:integration": "jest --testPathPattern=tests/integration",
    "eval": "tsx scripts/eval_prompts.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^0.2.35",
    "@langchain/core": "^0.3.26",
    "@langchain/openai": "^0.3.16",
    "@langchain/anthropic": "^0.3.14",
    "@langchain/google-genai": "^0.1.8",
    "@langchain/community": "^0.3.24",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "ioredis": "^5.3.2",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "uuid": "^10.0.0",
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "@types/diff": "^5.2.1",
    "@types/jest": "^29.5.12",
    "typescript": "^5.4.5",
    "tsx": "^4.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0"
  }
}
