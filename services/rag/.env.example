# ════════════════════════════════════════════════════════════════════════════
#  ManimRAG configuration. Copy to `.env` and fill in. Everything is opt-in —
#  no model or stage is hardcoded; all defaults shown below.
# ════════════════════════════════════════════════════════════════════════════

# ─── Vector store: MongoDB Atlas (free M0 supports Vector Search) ────────────
MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=manimrag_v2
VECTOR_STORE=mongodb_atlas
# Collection + index names (must be stable after seeding)
COLLECTION_NAME=manimrag_corpus
VECTOR_INDEX_NAME=manimrag_vector_index
TEXT_INDEX_NAME=manimrag_text_index

# ─── Embedder: Gemini ────────────────────────────────────────────────────────
# gemini-embedding-001 (text-embedding-004 is RETIRED). 3072 default; MRL
# truncation to 1536/768 supported via EMBEDDING_DIM. EMBEDDING_DIM MUST equal
# the index numDimensions and must never change post-seed without re-indexing.
EMBEDDER_PROVIDER=gemini
EMBEDDER_API_KEY=AIza...
# Optional: comma-separated keys, rotated across requests to dodge free-tier RPM.
# EMBEDDER_API_KEYS=AIza...key1,AIza...key2
EMBEDDER_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
EMBED_BATCH_SIZE=100

# ─── Query-transform LLM: MUST support tool_choice → glm-5.1 or kimi-k2.5 ────
# (DeepSeek/MiniMax/Qwen/MiMo run in thinking mode and reject tool_choice.)
LLM_PROVIDER=opencode
LLM_API_KEY=sk-...
LLM_MODEL=glm-5.1
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OpenCode-Go models default to slow "thinking" mode. Disabling it is ~5x faster
# and keeps tool_choice + JSON output intact. Leave true unless a model complains.
OPENCODE_DISABLE_THINKING=true

# ─── Reranker: plain completion → any model (high-quota deepseek-v4-flash) ───
RERANKER_PROVIDER=opencode
RERANKER_API_KEY=sk-...
RERANKER_MODEL=deepseek-v4-flash
RERANKER_TOP_N=5

# ─── Pipeline stages (opt-in at runtime) ─────────────────────────────────────
STAGE_QUERY_TRANSFORM=false    # glm-5.1 query understanding; ~3-4s even w/o thinking → off by default
STAGE_SPARSE=false             # Atlas BM25 + RRF fusion (needs the text index)
STAGE_RERANK=true              # deepseek reranker (~2s with thinking disabled) — fits the budget
STAGE_PITFALLS=true            # inject curated pitfalls/style into the grounded prompt

# ─── Retrieval tuning ────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
DENSE_TOP_K=40
DENSE_NUM_CANDIDATES=200
SPARSE_TOP_K=40
RERANK_CANDIDATES=20
RERANK_DOC_CHARS=600
RRF_K=60

# ─── Timeouts (ms) — keep p95 ≤ 3000ms, hard ceiling 5000ms ──────────────────
QUERY_TRANSFORM_TIMEOUT_MS=2200
EMBED_TIMEOUT_MS=8000
EMBED_BATCH_TIMEOUT_MS=30000
VECTOR_SEARCH_TIMEOUT_MS=5000
RERANK_TIMEOUT_MS=4000

# ─── Retry / backoff ─────────────────────────────────────────────────────────
RETRY_MAX=3
RETRY_BASE_MS=300

# ─── Service ─────────────────────────────────────────────────────────────────
RAG_API_KEY=                   # min 16 chars; openssl rand -hex 32
PORT=7000
HOST=0.0.0.0
LOG_LEVEL=info
RATE_LIMIT_MAX=120
# Optional SSRF guard: comma-separated allowed prefixes for per-request
# llm/reranker baseUrl overrides. Empty = allow any (dev convenience).
# ALLOWED_LLM_BASE_URLS=https://opencode.ai/zen/go/v1,https://api.openai.com/v1

# ─── Local dev: silence the OpenTelemetry exporter (no OTel in this build) ────
OTEL_SDK_DISABLED=true
