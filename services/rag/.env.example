# Local MongoDB with Search: mongodb/mongodb-atlas-local, not plain mongo.
MONGODB_URL=mongodb://localhost:27017/?directConnection=true
RAG_API_KEY=replace-with-at-least-16-characters

# Embeddings: "local" (default) runs a small CPU model inside the service.
# It needs no key. Weights download once into MODELS_DIR (baked into the Docker
# image, so the container needs no network). Other options: openai | gemini | ollama.
# Changing the provider or model needs `npm run seed:reset` (new vector dimensions).
EMBEDDER_PROVIDER=local
# EMBEDDER_MODEL=Xenova/bge-small-en-v1.5
# EMBEDDING_DIM=384
# MODELS_DIR=.models
# For openai or gemini embeddings set EMBEDDER_API_KEY (falls back to LLM_API_KEY).
# Gemini free tier allows 1000 embed requests per day: not enough to seed the
# 1,333-document corpus in one day. Use local, or a billed key.

# Only needed when you turn on STAGE_QUERY_TRANSFORM or STAGE_RERANK.
LLM_API_KEY=replace-with-your-provider-key

# openai | gemini | openrouter | ollama | opencodego
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# RERANKER_PROVIDER, RERANKER_MODEL, RERANKER_BASE_URL and RERANKER_API_KEY
# inherit the LLM settings unless specified.
STAGE_QUERY_TRANSFORM=false
STAGE_RERANK=false
STAGE_SPARSE=false
STAGE_PITFALLS=true
PORT=7000
HOST=0.0.0.0
OTEL_SDK_DISABLED=true
