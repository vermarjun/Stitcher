# Copy to .env and fill in the blanks. .env is git-ignored.

# --- Required ---
RENDER_API_KEY=change-me-to-at-least-sixteen-characters

# --- Deployment ---
ENV=dev                      # dev | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json              # json (prod) | text (dev)

# --- Sandbox ---
# Leave enabled in production. `false` is only safe for macOS dev without bwrap.
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_DEFAULT=120  # seconds
SANDBOX_MEMORY_MB_DEFAULT=2048
SANDBOX_CPU_DEFAULT=1.5

# --- Concurrency ---
# Good starting point: one per physical CPU core. Drop this if renders are OOM-ing.
MAX_CONCURRENT_RENDERS=4
QUEUE_FULL_POLICY=reject     # reject | block
QUEUE_WAIT_TIMEOUT_SEC=30

# --- Storage ---
# local | cloudinary | s3 | gcs | azure — must match the extra installed in the image.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/renders
LOCAL_STORAGE_PUBLIC_URL_BASE=http://localhost:8000/files/

# --- Cloudinary (STORAGE_BACKEND=cloudinary) ---
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- S3 / R2 / MinIO (STORAGE_BACKEND=s3) ---
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-renders
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# --- Observability ---
METRICS_ENABLED=true
