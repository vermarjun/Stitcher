# Copy to .env and fill in the blanks. .env is git-ignored.
# Every variable below is read by app/config.py, app/observability.py or docker-compose.yml.
# Comments sit on their own lines because some env-file parsers do not strip trailing ones.

# --- Required ---
# Shared secret for the X-Api-Key header. At least 16 characters.
RENDER_API_KEY=change-me-to-at-least-sixteen-characters

# --- Deployment ---
# dev | staging | production. production refuses to start with SANDBOX_ENABLED=false.
ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# --- Sandbox ---
# Needs the container recipe in docker-compose.yml (cap_add SYS_ADMIN, apparmor, seccomp
# and systempaths unconfined). Set false only for local runs without bwrap.
SANDBOX_ENABLED=true
# Default wall-clock seconds per render. A request can lower it, not raise it past MAX_TIMEOUT_SEC.
SANDBOX_TIMEOUT_DEFAULT=120
# Default memory cap in MB (RLIMIT_DATA per process). Requests can ask for another value.
SANDBOX_MEMORY_MB_DEFAULT=2048
# Default CPU count, used to size the CPU-time rlimit.
SANDBOX_CPU_DEFAULT=1.5

# --- Concurrency ---
# Default: number of CPU cores. Extra requests get 503 (reject) or wait (block).
MAX_CONCURRENT_RENDERS=4
# reject | block
QUEUE_FULL_POLICY=reject
QUEUE_WAIT_TIMEOUT_SEC=30

# --- Limits (optional, shown with their defaults) ---
# MAX_CODE_BYTES=524288
# MAX_AUDIO_BYTES=10485760
# MAX_TIMEOUT_SEC=600

# --- Storage ---
# local | cloudinary. The service serves local files at /files.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/renders
# URL prefix put in front of the stored file path. Must be reachable by whoever reads the video.
LOCAL_STORAGE_PUBLIC_URL_BASE=http://localhost:8000/files/

# --- Cloudinary (STORAGE_BACKEND=cloudinary, build with STORAGE=cloudinary) ---
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Tool paths (optional; the Docker image already sets these) ---
# MANIM_PATH=/opt/venv/bin/manim
# PYTHON_PATH=/opt/venv/bin/python
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Observability ---
METRICS_ENABLED=true
# OpenTelemetry over HTTP/protobuf. Optional, and fails soft if the collector is down.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=stitcher-render
# OTEL_SDK_DISABLED=true

# --- docker-compose.yml only (not read by the app) ---
# Host port to publish. Default 8000.
# PORT=8000
# Build args, also passed as `docker compose build` env: STORAGE=cloudinary, SLIM=1
