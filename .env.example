# Stitcher settings. Docker Compose reads this file as .env.
# Run ./scripts/setup.sh to create .env from this template. It fills the secrets
# and asks for your LLM provider and key.
# Every variable is described in docs/CONFIGURATION.md.
# All values below are placeholders.

# ─── Required ────────────────────────────────────────────────────────────────

# openai, anthropic, gemini, openrouter, groq, ollama or opencodego.
LLM_PROVIDER=gemini
# API key for that provider. Leave empty for ollama.
LLM_API_KEY=
# Model name. Empty uses the provider default (gemini: gemini-2.5-flash).
# openrouter has no default and needs a value here.
# LLM_MODEL=gemini-2.5-flash
# Custom endpoint for an OpenAI-compatible server. setup.sh sets it for ollama.
# LLM_BASE_URL=

# Secrets. setup.sh generates these. To make them by hand: openssl rand -hex 32
JWT_SECRET=
REDIS_PASSWORD=
AGENT_API_KEY=
RAG_API_KEY=
RENDER_API_KEY=

# ─── Where the app is served ─────────────────────────────────────────────────

# The address you type in the browser. Change it if you serve Stitcher from
# another host or behind a proxy. It is used for CORS and for media links.
PUBLIC_URL=http://localhost:8080
# Host port for the web app.
WEB_PORT=8080

# ─── Optional: different models per role ─────────────────────────────────────
# Each role falls back to LLM_*. A role on a different provider needs its own key.
# CODER_MODEL=
# DEBUGGER_MODEL=
# QUERY_TRANSFORM_MODEL=
# CODER_PROVIDER=
# CODER_API_KEY=
# CODER_BASE_URL=
# DEBUGGER_PROVIDER=
# DEBUGGER_API_KEY=
# DEBUGGER_BASE_URL=
# QUERY_TRANSFORM_PROVIDER=
# QUERY_TRANSFORM_API_KEY=
# QUERY_TRANSFORM_BASE_URL=

# ─── Optional: embeddings for retrieval ──────────────────────────────────────
# local runs a small model on CPU inside the RAG container. It needs no key.
# Other values: openai, gemini, ollama. Anthropic has no embeddings.
# After you change this, rebuild the index:
#   docker compose run --rm rag-seed node dist/seed.cjs --reset
EMBEDDER_PROVIDER=local
# EMBEDDER_MODEL=
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=
# Time limit for the query rewrite step. Hosted models need several seconds.
# QUERY_TRANSFORM_TIMEOUT_MS=6000
# Ollama on the host, for embeddings. setup.sh sets this for --embedder ollama.
# EMBEDDER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# The RAG service only speaks openai, gemini, openrouter, ollama and opencodego.
# For anthropic or groq, setup.sh points its fallback LLM at an OpenAI-compatible
# endpoint with these. You rarely need to touch them.
# RAG_LLM_PROVIDER=
# RAG_LLM_API_KEY=
# RAG_LLM_MODEL=
# RAG_LLM_BASE_URL=

# ─── Optional: voiceover ─────────────────────────────────────────────────────
# gtts needs no key but calls Google's speech endpoint, so the API container needs internet.
# azure needs the two keys below.
TTS_PROVIDER=gtts
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# DEFAULT_VOICEOVER_VOICE=
# DEFAULT_VOICEOVER_LANG=en

# ─── Optional: storage ───────────────────────────────────────────────────────
# local keeps videos in a Docker volume and serves them at /api/media.
# cloudinary uploads them to your Cloudinary account.
STORAGE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# MAX_UPLOAD_MB=500

# ─── Optional: email ─────────────────────────────────────────────────────────
# console prints each message, including signup codes, to the API log:
#   docker compose logs api | grep -i otp
# smtp sends through SMTP_*. gmail is an smtp preset (use an app password).
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# ─── Optional: Google sign-in ────────────────────────────────────────────────
# Leave empty to hide the button. The client id is baked into the web image,
# so rebuild it after a change: docker compose up -d --build web
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Optional: render service ────────────────────────────────────────────────
# Videos rendered at the same time. Each one can use about 2 GB of RAM.
# RENDER_MAX_CONCURRENT=2
# Smaller render image without texlive-science and vedo. See services/render/README.md.
# RENDER_SLIM=0
# Mirrors used while building the images, for slow networks.
# APT_MIRROR=http://cdn-aws.deb.debian.org
# APK_MIRROR=https://mirrors.edge.kernel.org/alpine
# PIP_INDEX_URL=

# ─── Optional: logs ──────────────────────────────────────────────────────────
# debug, info, warn or error.
# LOG_LEVEL=info

# ─── Optional: observability ─────────────────────────────────────────────────
# Grafana, Tempo, Loki, Prometheus and Langfuse. See observability/README.md.
# To use it, uncomment these two lines and start with:
#   docker compose --profile obs up -d
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Passwords for the observability containers. setup.sh fills these.
# GRAFANA_ADMIN_PASSWORD=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# Langfuse keys for the agent. Create them in the Langfuse UI.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Host ports for the observability UIs, bound to 127.0.0.1.
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# LANGFUSE_PORT=3002
