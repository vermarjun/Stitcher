                "description": "A star shape with pointed edges",
                "use_when": "Star symbols, decorative elements, ratings",
                "key_parameters": {
                    "n": "Number of points",
                    "outer_radius": "Distance to outer points",
                    "inner_radius": "Distance to inner points",
                    "density": "How many vertices to skip",
                    "color": "Outline color"
                }
            }
        },
