                    "height": "Vertical size",
                    "color": "Outline color"
                }
            },
            "Triangle": {
                "description": "An equilateral triangle",
                "use_when": "Triangular shapes, arrows, geometric demonstrations",
                "key_parameters": {
                    "color": "Outline color",
                    "fill_opacity": "Solidity of fill"
                }
            },
