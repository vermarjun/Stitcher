{
    "mobjects": {
        "text": {
            "Text": {
                "description": "Display regular text using system fonts (non-LaTeX)",
                "use_when": "Regular text, titles, labels, non-mathematical content, multilingual text",
                "key_parameters": {
                    "text": "The string to display",
                    "font_size": "Size of the text",
                    "color": "Color of the text",
                    "font": "Font family to use",
                    "line_spacing": "Spacing between lines of text",
                    "slant": "Text style (NORMAL or ITALIC)",
                    "weight": "Text weight (NORMAL or BOLD)",
                    "gradient": "Apply color gradient to text"
                },
                "positioning": "Can be placed anywhere on screen using standard positioning methods"
            },
            "MathTex": {
                "description": "Display LaTeX mathematical expressions in math mode",
                "use_when": "Math equations, formulas, mathematical notation, symbols",
                "key_parameters": {
                    "tex_strings": "LaTeX code for the math expression",
                    "color": "Color of the expression",
                    "font_size": "Size of the rendered math",
                    "tex_to_color_map": "Dictionary to color specific parts differently"
                }
            },
            "Tex": {
                "description": "Display LaTeX text in normal mode (non-math)",
                "use_when": "Formatted text with LaTeX styling, mixed text and math",
                "key_parameters": {
                    "tex_strings": "LaTeX code for the text",
                    "color": "Color of the text",
                    "font_size": "Size of the rendered text"
                }
            },
            "Paragraph": {
                "description": "Display multiple lines of text as a paragraph",
                "use_when": "Multi-line text blocks, formatted paragraphs",
                "key_parameters": {
                    "text": "Lines of text to display",
                    "line_spacing": "Spacing between lines",
                    "alignment": "Text alignment (left, right, center)"
                }
            },
            "BulletedList": {
                "description": "Display a bulleted list of items",
                "use_when": "Lists, enumerated points, itemized content",
                "key_parameters": {
                    "items": "List items to display",
                    "buff": "Spacing between items",
                    "dot_scale_factor": "Size of the bullet points"
                }
            },
            "Title": {
                "description": "Display an underlined title at the top of the scene",
                "use_when": "Scene titles, headers, section headings",
                "key_parameters": {
                    "text_parts": "The title text",
                    "include_underline": "Whether to show underline",
                    "underline_buff": "Space between text and underline"
                }
            },
            "Code": {
                "description": "Display syntax-highlighted source code",
                "use_when": "Programming code snippets, code demonstrations",
                "key_parameters": {
                    "code_file": "Path to code file to display",
                    "code_string": "Code as a string",
                    "language": "Programming language for syntax highlighting",
                    "tab_width": "Width of tab characters",
                    "add_line_numbers": "Whether to show line numbers",
                    "background": "Background style (rectangle or window)"
                }
            }
        },
        "geometry_basic": {
            "Circle": {
                "description": "A circular shape",
                "use_when": "Circles, dots, highlighting circular areas, representing points",
                "key_parameters": {
                    "radius": "Size of the circle",
                    "color": "Outline color",
                    "fill_opacity": "How solid the fill is (0=transparent, 1=solid)",
                    "fill_color": "Interior color when filled",
                    "stroke_width": "Thickness of the outline"
                }
            },
            "Square": {
                "description": "A square shape with equal sides",
                "use_when": "Squares, boxes, grid cells, array elements",
