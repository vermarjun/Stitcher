# FROM python:3.11-slim
FROM python:3.11-slim

# Comprehensive OS dependencies for Manim rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    pkg-config \
    cmake \
    \
    # FFmpeg for video rendering
    ffmpeg \
    \
    # ImageMagick for image processing
    imagemagick \
    \
    # Ghostscript for PDF/PS rendering
    ghostscript \
    \
    # Poppler utils for PDF handling
    poppler-utils \
    \
    # Cairo / Pango / GDK for Manim cairo backend
    libcairo2 \
    libcairo2-dev \
    libpango-1.0-0 \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-0 \
    libgdk-pixbuf-2.0-dev \
    \
    # Font libraries
    fonts-lmodern \
    fonts-dejavu \
    fonts-liberation \
    \
    # Image libraries
    libpng-dev \
    libjpeg-dev \
    zlib1g-dev \
    \
    # Build helpers
    libffi-dev \
    libssl-dev \
    \
    # TeX Live packages for MathTex/Tex rendering
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-xetex \
    texlive-fonts-extra \
    texlive-lang-english \
    texlive-science \
    cm-super \
    \
    # dvisvgm - CRITICAL for Manim SVG conversion from LaTeX
    dvisvgm \
    \
    # dvipng for PNG output from DVI files
    dvipng \
    \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# RUN apt-get update && apt-get install -y --no-install-recommends \
#     # Basic dependencies (~500 MB)
#     build-essential git curl wget ca-certificates \
#     pkg-config cmake ffmpeg imagemagick ghostscript \
#     poppler-utils libcairo2 libcairo2-dev \
#     libpango-1.0-0 libpango1.0-dev \
#     libgdk-pixbuf-2.0-0 libgdk-pixbuf-2.0-dev \
#     fonts-lmodern fonts-dejavu fonts-liberation \
#     libpng-dev libjpeg-dev zlib1g-dev \
#     libffi-dev libssl-dev \
#     # Minimal TeX (~800 MB instead of 4 GB!)
#     texlive-latex-base \
#     texlive-latex-recommended \
#     dvisvgm \
#     dvipng \
#     && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy worker requirements
COPY requirements_worker.txt /app/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Copy the rest of the code
COPY . /app

ENV PYTHONPATH=/app

# Configure ImageMagick policy for Manim (allow PDF/EPS conversion)
RUN sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' /etc/ImageMagick-6/policy.xml || true && \
    sed -i 's/rights="none" pattern="EPS"/rights="read|write" pattern="EPS"/' /etc/ImageMagick-6/policy.xml || true && \
    sed -i 's/rights="none" pattern="PS"/rights="read|write" pattern="PS"/' /etc/ImageMagick-6/policy.xml || true

# CMD ["bash", "-lc", "rq worker -u redis://default:$REDIS_PASSWORD@$REDIS_HOST:$REDIS_PORT scene_rendering"]
CMD ["bash", "-lc", "set -a && source /app/.env && set +a && rq worker -u redis://default:$REDIS_PASSWORD@$REDIS_HOST:$REDIS_PORT scene_rendering"]