# ─────────────────────────────────────────────────────────────────────────────
#  .env.docker.example — environment variables for Docker Compose
#
#  Copy this file to API/.env.docker and fill in real secrets.
#  The compose file reads: ./API/.env.docker
#
#  cp .env.docker.example API/.env.docker
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose infrastructure ────────────────────────────────────────────────────
# Redis password (used by the redis service itself AND all services connecting to it)
REDIS_PASSWORD=dev_redis_password

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Database (uses compose service name, not localhost) ───────────────────────
MONGODB_URL=mongodb://mongo:27017/stitcher

# ── Redis (uses compose service name + password) ─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is already set above — duplicated here for clarity
# REDIS_PASSWORD=dev_redis_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Razorpay ──────────────────────────────────────────────────────────────────
RZP_KEY_ID=your_rzp_key_id
RZP_KEY_SECRET=your_rzp_key_secret

# ── API-key encryption ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
KEYS_ENCRYPTION_KEY=run_openssl_rand_hex_32_to_generate

# ── Inter-service URLs (uses compose service names) ──────────────────────────
RAG_SERVICE_URL=http://rag-service:7000
RAG_API_KEY=change_me_rag_api_key
AGENT_SERVICE_URL=http://agent-service:4000
AGENT_API_KEY=change_me_agent_api_key
RENDER_SERVICE_URL=http://render-service:8000
RENDER_API_KEY=change_me_render_api_key

# ── Agent service (Manim-Agent-Service) ───────────────────────────────────────
# Redis URL is overridden in docker-compose.services.yml automatically.
# CHECKPOINT_REDIS_URL=redis://:dev_redis_password@redis:6379
DEFAULT_PROVIDER=openai
DEFAULT_MODEL_PLANNER=gpt-4o
DEFAULT_MODEL_CODER=gpt-4o
DEFAULT_MODEL_DEBUGGER=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# ── RAG service (ManimRAG/pipeline) ───────────────────────────────────────────
MONGODB_DB_NAME=manimrag
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
EMBEDDER_PROVIDER=openrouter
EMBEDDER_API_KEY=
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_PROVIDER=openrouter
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
# VECTOR_STORE and QDRANT_URL are set in docker-compose.services.yml automatically.
# VECTOR_STORE=qdrant
# QDRANT_URL=http://qdrant:6333

# ── Render service (manim-render-service) ─────────────────────────────────────
# bubblewrap sandbox is Linux-only. Set to false on macOS / Windows Docker Desktop.
SANDBOX_ENABLED=false
