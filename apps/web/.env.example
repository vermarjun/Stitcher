# Copy to .env (or .env.local) before running `npm run dev` or `npm run build`.
# Vite reads these at build time, so rebuild after changing them.

# Base URL of the Stitcher API, including the /api prefix.
# The Socket.IO connection uses the same host without /api.
# Default: http://localhost:3000/api
VITE_BACKEND_URL=http://localhost:3000/api

# Google OAuth client id. Optional. When empty, the "Continue with Google"
# button is hidden. The API needs the matching GOOGLE_CLIENT_ID and secret.
VITE_GOOGLE_CLIENT_ID=
