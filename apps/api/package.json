{
  "name": "api",
  "version": "0.1.0",
  "description": "Stitcher backend API — orchestrates RAG, agent, and render services for Manim-based video generation.",
  "main": "index.js",
  "author": "vermarjun <vermarjun.work@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vermarjun/Stitcher.git"
  },
  "keywords": [
    "manim",
    "video-generation",
    "ai",
    "saas"
  ],
  "scripts": {
    "build": "npx tsc -b",
    "start": "node -r ./dist/instrumentation.js dist/index.js",
    "dev": "tsx --import ./src/instrumentation.ts src/index.ts",
    "migrate:aura": "ts-node src/scripts/aura.migration.ts",
    "migrate:stats": "ts-node src/scripts/userstats.migration.ts",
    "seed:templates": "ts-node src/scripts/templates.seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:mock": "tsx scripts/smoke.ts --mock"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.6",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^164.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "nanoid": "^3.3.12",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "razorpay": "^2.9.6",
    "redis": "^4.6.10",
    "socket.io": "^4.8.1",
    "winston": "^3.11.0",
    "y-socket.io": "^1.1.3",
    "yjs": "^13.6.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.x",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.x",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.x",
    "@types/nodemailer": "^6.4.17",
    "@types/socket.io-client": "^1.4.36",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vitest/ui": "^4.1.5",
    "nock": "^14.0.15",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.x",
    "tsx": "^4.21.0",
    "typescript": "^5.x",
    "vitest": "^4.1.5"
  }
}
