# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Database
MONGODB_URL=mongodb://localhost:27017/stitcher

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Email (Gmail App Password)
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay
RZP_KEY_ID=your_rzp_key_id
RZP_KEY_SECRET=your_rzp_key_secret

# Phase B — external services (required at boot even in dev; use placeholder values until services are live)
RAG_SERVICE_URL=http://localhost:7000
RAG_API_KEY=change_me_rag_api_key
AGENT_SERVICE_URL=http://localhost:4000
AGENT_API_KEY=change_me_agent_api_key
RENDER_SERVICE_URL=http://localhost:8000
RENDER_API_KEY=change_me_render_api_key
