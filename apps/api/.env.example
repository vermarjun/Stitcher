# Stitcher API environment. Copy to .env and edit.
# Only the "Required" block must be set. Everything else has a default.
# All values below are placeholders.

# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string.
MONGODB_URL=mongodb://localhost:27017/stitcher

# Redis (BullMQ queues and Socket.IO events).
REDIS_HOST=localhost
# Redis port. Default 6379.
REDIS_PORT=6379
# Redis password. Empty means no password.
REDIS_PASSWORD=

# Secret that signs login tokens. At least 32 characters. Try: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Internal services. The API refuses to boot without these.
RAG_SERVICE_URL=http://localhost:7000
RAG_API_KEY=replace-me
AGENT_SERVICE_URL=http://localhost:4000
AGENT_API_KEY=replace-me
RENDER_SERVICE_URL=http://localhost:8000
RENDER_API_KEY=replace-me

# ─── Optional: server ────────────────────────────────────────────────────────

# development, production or test. Default development.
NODE_ENV=development
# HTTP port. Default 3000.
PORT=3000
# URL prefix for every route. Default /api. Use an empty value for no prefix.
API_PREFIX=/api
# Comma-separated browser origins allowed by CORS. Default http://localhost:5173.
ALLOWED_ORIGINS=http://localhost:5173
# URL of the web app, used in email links. Default is the first ALLOWED_ORIGINS entry.
PUBLIC_APP_URL=
# Public URL of this API without the prefix, used to build media URLs for local storage.
# Default http://localhost:PORT.
PUBLIC_API_URL=
# debug, info, warn or error. Default info.
LOG_LEVEL=info

# ─── Optional: LLM provider ──────────────────────────────────────────────────
# One default LLM serves every role. Providers: openai, anthropic, gemini,
# openrouter, groq, ollama, opencodego.

# Default provider. Default openai.
LLM_PROVIDER=openai
# Model name. Defaults: openai gpt-4.1-mini, anthropic claude-sonnet-5-5,
# gemini gemini-2.5-flash, groq llama-3.3-70b-versatile, ollama llama3.1.
# openrouter has no default and needs LLM_MODEL.
LLM_MODEL=
# API key for the provider. Not needed for ollama.
LLM_API_KEY=
# Custom endpoint for an OpenAI-compatible server. ollama defaults to http://localhost:11434/v1.
LLM_BASE_URL=

# Per-role overrides. Each field falls back to LLM_* when the role uses the same
# provider. Use these to run, for example, a cheaper model for debugging.
# Roles: CODER (writes scene code), DEBUGGER (fixes failed renders),
# QUERY_TRANSFORM (rewrites the prompt for retrieval).
CODER_PROVIDER=
CODER_MODEL=
CODER_API_KEY=
CODER_BASE_URL=
DEBUGGER_PROVIDER=
DEBUGGER_MODEL=
DEBUGGER_API_KEY=
DEBUGGER_BASE_URL=
QUERY_TRANSFORM_PROVIDER=
QUERY_TRANSFORM_MODEL=
QUERY_TRANSFORM_API_KEY=
QUERY_TRANSFORM_BASE_URL=

# Embedder override sent to the RAG service. Leave EMBEDDER_PROVIDER empty to
# use the RAG service's own embedder (it must match the vectors in its index).
# Providers: gemini, openai, ollama.
EMBEDDER_PROVIDER=
EMBEDDER_MODEL=
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=

# ─── Optional: voiceover ─────────────────────────────────────────────────────

# gtts (free, no key) or azure. Default gtts.
TTS_PROVIDER=gtts
# Azure Speech credentials, only used when TTS_PROVIDER=azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Default voice for Azure, for example en-US-AvaNeural.
DEFAULT_VOICEOVER_VOICE=
# Default language code. Default en.
DEFAULT_VOICEOVER_LANG=en
# Parallel voiceover requests per job. Default 3.
TTS_MAX_CONCURRENCY=3

# ─── Optional: storage ───────────────────────────────────────────────────────

# local (default) or cloudinary.
STORAGE=local
# Folder for local storage. Served at ${API_PREFIX}/media. Default ./data/media.
STORAGE_DIR=./data/media
# Largest upload accepted by POST /asset/upload, in MB. Default 500.
MAX_UPLOAD_MB=500
# Cloudinary credentials. Required only when STORAGE=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional: email ─────────────────────────────────────────────────────────
# Used for the signup code and password reset.

# console (default) prints each message, including signup codes, to the API log.
# smtp sends through SMTP_*. gmail is an smtp preset for smtp.gmail.com.
EMAIL_PROVIDER=console
SMTP_HOST=
# Default 587 for smtp, 465 for gmail. Port 465 uses TLS.
SMTP_PORT=
SMTP_USER=
# For gmail, use an app password.
SMTP_PASS=
# From header, for example "Stitcher <no-reply@example.com>". Default is built from SMTP_USER.
EMAIL_FROM=

# ─── Optional: Google sign-in ────────────────────────────────────────────────
# Leave empty to disable. GET /users/google then answers 404 google_auth_disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: timeline export ───────────────────────────────────────────────

# ffmpeg binary used for export. Default: ffmpeg from PATH.
EXPORT_FFMPEG_PATH=
# Font file used for text overlays in the export. Default: first common system font found.
EXPORT_FONT_PATH=

# ─── Optional: OpenTelemetry ─────────────────────────────────────────────────
# Tracing and metrics stay off unless the endpoint is set.

# OTLP/HTTP collector base URL, for example http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=stitcher-api
# Sampler name. Default always_on.
OTEL_TRACES_SAMPLER=
