# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Database
MONGODB_URL=mongodb://localhost:27017/stitcher

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# ── Email ───────────────────────────────────────────────────────────────────
# Pluggable sender. "gmail" (default) sends via Gmail; "console" just logs the
# email (use for local dev / self-host with no mail credentials).
EMAIL_PROVIDER=gmail
# Sending Gmail address (also the OAuth/SMTP identity). Required.
EMAIL_USER=you@gmail.com
# Optional friendly From. Must be EMAIL_USER or a verified Gmail alias.
# Defaults to "Stitcher <EMAIL_USER>" when unset.
# EMAIL_FROM=Stitcher <you@gmail.com>
#
# Gmail auth — pick ONE mode:
#
# Mode A (recommended) — OAuth2 / "send via API". In Google Cloud Console create
# an OAuth 2.0 Client (type: Web), add https://developers.google.com/oauthplayground
# as an authorized redirect, then in the OAuth Playground authorize the scope
# https://mail.google.com/ and exchange for a refresh token. Fill these three:
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
#
# Mode B (simple fallback) — Gmail App Password. Used only when the OAuth2 vars
# above are blank. Generate at https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your_gmail_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay
RZP_KEY_ID=your_rzp_key_id
RZP_KEY_SECRET=your_rzp_key_secret

# Phase B — external services (required at boot even in dev; use placeholder values until services are live)
RAG_SERVICE_URL=http://localhost:7000
RAG_API_KEY=change_me_rag_api_key
AGENT_SERVICE_URL=http://localhost:4000
AGENT_API_KEY=change_me_agent_api_key
RENDER_SERVICE_URL=http://localhost:8000
RENDER_API_KEY=change_me_render_api_key

# API-key encryption — run `openssl rand -hex 32` to generate
KEYS_ENCRYPTION_KEY=run_openssl_rand_hex_32_to_generate

# Observability (OpenTelemetry) — all optional; the API boots fine without them.
# OTLP/HTTP endpoint (port 4318). Local dev default if unset: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=stitcher-api
OTEL_TRACES_SAMPLER=always_on
# bull-board queue dashboard at ${API_PREFIX}/admin/queues. "true" mounts it
# (still requires a valid JWT). Leave "false" unless you need it locally.
ADMIN_DASHBOARD_ENABLED=false
